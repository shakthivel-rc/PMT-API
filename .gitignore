# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
.env
.venv/
env-test/
pip-log.txt
pip-delete-this-directory.txt

# FastAPI specific
instance/
db.sqlite3
*.log
*.pid
*.seed
*.env
# Every .env sibling, not just the bare name. `.env` and `*.env` between them miss
# `.env.bak.<timestamp>`, `.env.local`, `.env.prod` — files that hold the same
# SECRET_KEY and SMTP_PASSWORD as the original and were one `git add -A` from being
# published. Ship .env.example and nothing else.
.env.*
!.env.example
*.local

# Testing
.coverage
# `.coverage` alone misses what pytest-cov actually writes when it runs in parallel or
# under a plugin that sets COVERAGE_FILE: `.coverage.<host>.<pid>.<random>`. One of those
# was sitting untracked in this repository on 2026-08-26. Harmless in itself — the point is
# that the rule which was supposed to catch it did not, and the next file that shape might
# not be coverage data.
.coverage.*
coverage-*.xml
.tox/
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
htmlcov/
# Anchored (2026-10-06): the test runners write `reports/` at the repository root. Unanchored,
# `reports/` also matched `services/reports/` — the reports SOURCE package — so a new module
# there was silently never committed; only files tracked before the rule existed survived.
/reports/

# MyPy Type Checking
.mypy_cache/
# Ruff writes its own `*` .gitignore inside this, which git honours; listed here as well
# because scripts/check_staged_secrets.py, outside a git checkout, reads only this file.
.ruff_cache/

# Jupyter Notebooks
.ipynb_checkpoints

# IDE files
.vscode/
.idea/
*.sublime-workspace

# Git files
*.swp
*.swo
.DS_Store
*.bak

# Docker
# A local-only override, by convention. Everything else Docker-related — the Dockerfile,
# docker-compose.yml and .dockerignore — is committed on purpose: they are how someone
# runs this from a clone.
docker-compose.override.yml

# .dockerignore was ignored here. That is actively dangerous, not merely untidy: without it
# in a fresh clone, `COPY . .` bakes the developer's .env — real SECRET_KEY, real database
# credentials — into the image, and `docker history` will show it to anyone who pulls.

# Local scratch virtualenv
myenv/
