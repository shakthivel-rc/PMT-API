# Keep the build context small and keep secrets out of the image.
.git
.github
.venv
env/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Never bake real configuration into an image. The container reads its environment from
# compose; .env.example is the template a human copies.
.env
.env.*
!.env.example

*.md
!README.md
