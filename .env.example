# Base Project API — copy to .env and fill in. Never commit a filled-in copy.
#
# load_dotenv() reads the CURRENT WORKING DIRECTORY, so always start the backend from
# pmt-api/. Settings are lru_cache'd and read at *import* time: a missing
# required value raises RuntimeError before uvicorn starts, and changing the environment
# after first access has no effect.

# --- Required. The process will not start without these two. ---------------------
# Also read directly by alembic/env.py.
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/base_project

# WARNING: this one value does two jobs — it signs JWTs, and it is the Fernet key in
# utils/token.py used for verify/reset links. Rotating it therefore invalidates every
# outstanding reset link. ENVIRONMENT=prod refuses a short or low-entropy value.
#
# Must be a valid urlsafe-base64 32-byte Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# --- Application ------------------------------------------------------------------
APP_NAME=Base Project API
# "prod" activates the production guards: no "*" in CORS_ORIGINS, a strong SECRET_KEY, no
# SQLite DATABASE_URL, and no placeholder SUPERADMIN_PASSWORD.
ENVIRONMENT=development
LOG_LEVEL=INFO

# CSV. NOTE: the default (http://localhost:5173) does NOT match the dev server, which
# runs on port 3000.
CORS_ORIGINS=http://localhost:3000

# --- Auth -------------------------------------------------------------------------
ALGORITHM=HS256
# HOURS, despite the unit-free name.
JWT_EXPIRY_VALUE=1
REFRESH_TOKEN_EXPIRY_DAYS=30
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12

# --- Inbound rate limiting --------------------------------------------------------
# Per client address, per minute, counted IN THIS PROCESS. Two uvicorn workers means two
# counters and therefore twice the limit; a replica set multiplies it again. That is a
# real limitation and it is written down rather than papered over — see core/ratelimit.py.
# An in-process limit still turns an unbounded credential-stuffing run into a bounded one.
RATE_LIMIT_ENABLED=true

# The login/register/OTP/password-reset endpoints. Small on purpose: the per-account
# lockout above fires at 5 failures, so this number is not about one account — it caps how
# fast one client can work through MANY accounts, and how much mail it can make us send.
RATE_LIMIT_CREDENTIAL_PER_MINUTE=10

# Everything else. Five requests a second, sustained; the heaviest screen issues only a
# handful.
RATE_LIMIT_GENERAL_PER_MINUTE=300

# Which peers' X-Forwarded-For header may be believed. CSV of addresses or CIDRs; empty
# means nobody, and the peer address is used as-is.
#
# READ THIS IF YOU RUN BEHIND A PROXY. nginx in the shipped docker-compose proxies /api/
# to this service, so without an entry here every request arrives from the nginx
# container's address and every client shares ONE rate-limit bucket — any client can
# then exhaust the login budget for every user at once. docker-compose.yml sets this to
# the bridge network for exactly that reason.
#
# An allow-list rather than an on/off switch, because neither setting of a switch is
# correct: X-Forwarded-For is caller-controlled, so believing it unconditionally hands an
# attacker a fresh bucket per request, and ignoring it entirely creates the shared bucket
# above. Believing it only when the PEER is a proxy you named is neither.
#
# The right-most entry that is not itself a trusted proxy is used, because nginx APPENDS
# the peer to whatever the client sent — so the left-most entry is attacker-supplied.
TRUSTED_PROXY_IPS=

# The largest request body this API will read, in bytes. 0 disables the ceiling entirely.
#
# Nothing bounded a request body before this existed: Starlette buffers the body before a
# handler ever sees it, and the rate limiter counts requests, not bytes — so one client
# could hold as much of this process's memory as it cared to send, at a cost to itself of
# one connection. `core/middleware.py:BodySizeLimitMiddleware` enforces it, and it checks
# BOTH the declared Content-Length (cheap, refuses before a byte of body is read) and the
# bytes that actually arrive (because a chunked request declares no length at all, so the
# cheap check alone would be a ceiling anyone could opt out of by not mentioning it).
#
# 4 MiB: the largest legitimate body the base API accepts is a JSON user/role payload of a
# few kB, so this is orders of magnitude of headroom. Raise it if you add endpoints that
# accept large payloads; a request over the ceiling is refused with 413 and the
# operator-facing message says the limit, so the symptom names its own cause.
#
# Set it too low and legitimate writes start failing at 413. Set it to 0 and you are back
# to where this line came from.
#
# NOTE: set the same ceiling on your reverse proxy — nginx's `client_max_body_size` — so an
# oversized body is refused before it crosses the network to this process at all. This
# setting is the backstop, not the first line.
MAX_REQUEST_BODY_BYTES=4194304

# --- Database pool ----------------------------------------------------------------
# Ignored on SQLite, whose pool takes none of these.
#
# 20 + 20 = 40 connections, derived rather than guessed: Starlette runs the `def` request
# handlers in a threadpool of 40. SQLAlchemy's default is 5 + 10, which does not fail
# loudly against a 40-slot threadpool — it queues, and the symptom is latency nobody can
# attribute to a pool nobody has looked at.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20

# Recycle a connection after half an hour, comfortably under MySQL's wait_timeout and
# under the idle timeout of every load balancer that sits in front of one. pool_pre_ping
# stays on as well: recycle handles the timeout you know about, pre-ping handles the
# connection something else severed.
DB_POOL_RECYCLE_SECONDS=1800

# --- Logging ----------------------------------------------------------------------
# Literal secret values to mask in every log line, on top of the generic credential shapes
# in core/redact.py — a shared service password or a key issued as a plain word, which
# no regex could recognise. CSV. Values shorter than 6 characters are ignored, because
# masking every occurrence of a 3-character "secret" would shred the log without
# protecting anything.
LOG_EXTRA_SECRETS=

# --- Email ------------------------------------------------------------------------
# Where the SPA is served, as the person reading the email reaches it. The invite and reset
# emails link to <APP_BASE_URL>/verify-account?token=… and <APP_BASE_URL>/reset-password?token=…
# — and a scheduled report too big to attach links to <APP_BASE_URL>/reports/jobs/<id>
# (workers/report_worker.py; the report worker needs this and the SMTP values below too).
# (utils/token.py:app_link). Read per email, not at startup; a trailing slash is harmless.
# Unset, the links are relative and no mail client can open them. This default is the Vite
# dev server a native setup runs; `make setup` in Docker mode moves it to APP_PORT.
APP_BASE_URL=http://localhost:3000

# Outside the Settings dataclass and unvalidated at startup, so a typo surfaces only
# when an email is actually sent. Despite the module being named aws_ses.py this uses
# stdlib smtplib and NOT boto3. There is no socket timeout: an unresponsive relay
# hangs the request. With SMTP_HOST or SMTP_FROM_EMAIL empty, mail is logged, not sent —
# and the invite/reset links in the logged copy have their token masked by the log
# redactor, so those two flows need a real (or catcher) SMTP server even locally. A mail
# catcher: `docker run --rm -p 1025:1025 -p 8025:8025 axllent/mailpit`, then SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_USE_TLS=false and any
# SMTP_FROM_EMAIL; the mail is at http://localhost:8025. See integrations/README.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Base Project
SMTP_USE_TLS=true

# --- Setup: ports and compose -------------------------------------------------------
# Written by scripts/bootstrap.sh, which checks each one is actually free first and moves
# it if it is not. Everything that names a port — APP_BASE_URL and CORS_ORIGINS above,
# the published ports in docker-compose.yml, the dev servers `make dev` starts — reads
# these, so changing one here is enough.
#
# MYSQL_PORT and API_PORT are published on 127.0.0.1 only; APP_PORT is the one that is
# reachable from the network.
MYSQL_PORT=3307
API_PORT=8000
APP_PORT=8080
# The Vite dev server (`make dev` / `npm run dev`). Only used in a native setup.
APP_DEV_PORT=3000

# The compose project name: the prefix on every container, network and volume. Leave it
# unset unless setup wrote one — it does that only to stand a second stack up beside a
# database volume whose password this .env no longer has.
# COMPOSE_PROJECT_NAME=base-project

# The database image. A backstop for an architecture with no image for the default tag,
# not a general knob — the schema and migrations are written against MySQL 8.
# MYSQL_IMAGE=mysql:8.0

# --- Project management: integrations and AI (docs/design/) ----------------------
# The shared secret of the GitHub App (or repository webhook) that posts to
# POST /integrations/github/webhook. Every delivery is verified against it with
# HMAC-SHA256 over the raw body (X-Hub-Signature-256). EMPTY MEANS EVERY DELIVERY IS
# REFUSED — there is nothing to verify a signature against, and an unverified webhook
# would let anyone on the internet mark a ticket Done. Generate one with
#   python -c "import secrets; print(secrets.token_hex(32))"
# and paste the same value into the GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=

# The AI features (thread summaries today). Off by default: turning them on sends issue
# text to the Claude API. With AI_ENABLED=false the summary endpoint answers 503 and the
# worker (`python -m workers.ai_worker`) refuses to start.
AI_ENABLED=false
# The Claude model the worker calls. The worker reads ANTHROPIC_API_KEY from its own
# environment through the Anthropic SDK; the API process never needs the key, because the
# API process never calls the model (docs/design/03-ai-strategy.md).
AI_MODEL=claude-opus-5
# output_config.effort: low | medium | high | xhigh | max. `high` is the API default.
# Summaries are a candidate for `medium` — measure quality on real threads before lowering it.
AI_EFFORT=high
# How many times one job is tried before it is marked failed. Each try already includes
# the SDK's own 2 retries for 429/5xx, so 3 here is up to 9 requests over ~15 minutes.
AI_MAX_ATTEMPTS=3
# Read by the Anthropic SDK in the worker, not by core/config.py. Never set it on the API.
# ANTHROPIC_API_KEY=

# --- Seeder only ------------------------------------------------------------------
# Required only by `python -m seeders.user_seeder`, which raises without it.
# Prefer passing it inline for one-off runs rather than persisting it here.
SUPERADMIN_PASSWORD=

# The seeded accounts' sign-in addresses. Default to superadmin@base-project.local and
# member@base-project.local — .local is reserved and unroutable, so a default install
# cannot be mistaken for a real mailbox.
#
# The seeder matches on email, so changing these does NOT rename an account that already
# exists; it creates another one.
SUPERADMIN_EMAIL=
SEED_MEMBER_EMAIL=
